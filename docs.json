{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Desk Docs",
  "description": "Documentation for the Desk ticketing app.",
  "colors": {
    "primary": "#0F5F73",
    "light": "#578F9D",
    "dark": "#0F5F73"
  },
