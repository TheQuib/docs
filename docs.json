          },
          {
            "group": "Clients and locations",
            "pages": ["admin/clients", "admin/locations"]
          },
          {
            "group": "Tickets",
            "root": "admin/tickets/index",
            "pages": ["admin/tickets/categories", "admin/tickets/lifecycle"]
          },
          {
            "group": "SLAs",
            "root": "admin/slas/index",
            "pages": [
              "admin/slas/how-slas-work",
              "admin/slas/set-up",
              "admin/slas/hours-and-holidays",
              "admin/slas/targets",
              "admin/slas/reminders",
              "admin/slas/turn-off"
            ]
          },
          {
            "group": "Email and notifications",
            "root": "admin/notifications/index",
            "pages": [
              "admin/notifications/outbound-email",
              "admin/notifications/inbound-email",
              "admin/notifications/who-gets-notified",
              "admin/notifications/push",
              "admin/notifications/email-activity"
            ]
          },
          {
            "group": "Branding",
            "pages": ["admin/branding"]
          },
          {
            "group": "Reference",
            "pages": ["admin/settings-reference"]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "admin/troubleshooting/email",
              "admin/troubleshooting/sign-in",
              "admin/troubleshooting/notifications",
              "admin/troubleshooting/get-help"
            ]
          }
        ]
      },
      {
        "tab": "Using desk",
        "icon": "ticket",
        "groups": [
          {
            "group": "Get started",
            "pages": ["using/index", "using/sign-in", "using/install-app"]
          },
          {
            "group": "Work tickets",
            "pages": [
              "using/ticket-list",
              "using/ticket-page",
              "using/replies-and-notes",
